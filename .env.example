# ─────────────────────────── Site ───────────────────────────
# "production" only on the live deployment; anything else is a preview (noindex, placeholder badge).
NEXT_PUBLIC_SITE_ENV=preview
NEXT_PUBLIC_SITE_URL=https://axelsafe-transporting.com

# ─────────────────────────── Lead store (pick ONE) ───────────────────────────
# Production: Supabase project (run supabase/migrations/0001_crm.sql, then 0002_crm_v2.sql).
# Service-role key — server only, NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local development only: JSON files in .data/ (leads.json, users.json). Refused when NODE_ENV=production.
# LEADS_DRIVER=local

# ─────────────────────────── Admin CRM (/admin) ───────────────────────────
# Signs the session cookie (required). Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# CRM accounts are per user (admin_users table), created with:  pnpm admin:user --email … --name "…"
# ADMIN_PASSWORD is ONLY a bootstrap fallback: it works while no active user exists and stops working
# (sessions included) as soon as the first account is created.
ADMIN_PASSWORD=
# Author name shown on CRM events for the fallback login (optional, default "admin").
# ADMIN_AUTHOR_NAME=Dispecerat

# Salt for hashing visitor IPs (optional; falls back to ADMIN_SESSION_SECRET). openssl rand -hex 16
# IP_HASH_SALT=

# ─────────────────────────── E-mail notifications (optional) ───────────────────────────
# New-lead e-mail (Romanian, with type, route and a direct /admin link) via Resend REST API.
# Covers every website form: quote, quick quote, carrier, callback. Both must be set to activate.
# RESEND_API_KEY=
# LEADS_NOTIFY_TO=office@axelsafe-transporting.com
# Sender must be on a domain verified in Resend. Default: AXEL SAFE Website <no-reply@axelsafe-transporting.com>
# LEADS_NOTIFY_FROM="AXEL SAFE Website <no-reply@axelsafe-transporting.com>"
