# ─────────────────────────── Site ───────────────────────────
# "production" only on the live deployment; anything else is a preview (noindex, placeholder badge).
NEXT_PUBLIC_SITE_ENV=preview
NEXT_PUBLIC_SITE_URL=https://axelsafe-transporting.com

# ─────────────────────────── Lead store (pick ONE) ───────────────────────────
# Production: Supabase project (run supabase/migrations/0001_crm.sql first).
# Service-role key — server only, NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local development only: JSON file store at .data/leads.json (refused when NODE_ENV=production).
# LEADS_DRIVER=local

# ─────────────────────────── Admin CRM (/admin) ───────────────────────────
# Shared password for v1. Generate the secret with: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Name recorded as author on CRM events (optional, default "admin").
# ADMIN_AUTHOR_NAME=Dispatcher

# Salt for hashing visitor IPs (optional; falls back to ADMIN_SESSION_SECRET). openssl rand -hex 16
# IP_HASH_SALT=

# ─────────────────────────── E-mail notifications (optional) ───────────────────────────
# New-lead e-mail via Resend REST API. Both must be set to activate.
# RESEND_API_KEY=
# LEADS_NOTIFY_TO=office@axelsafe-transporting.com
# Sender must be on a domain verified in Resend. Default: AXEL SAFE Website <no-reply@axelsafe-transporting.com>
# LEADS_NOTIFY_FROM="AXEL SAFE Website <no-reply@axelsafe-transporting.com>"
